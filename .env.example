# Kopieer dit bestand naar .env en vul het in. .env staat in .gitignore en komt NOOIT in GitHub.

# Poort waarop de app draait (standaard 3000)
PORT=3000

# Adres waarop collega's de app openen; wordt als link in de e-mails gezet
APP_URL=http://localhost:3000

# --- E-mail via Gmail ---------------------------------------------------------
# Gebruik een APART Gmail-account (bijv. verbeterregistratie.egency@gmail.com).
# 1. Zet 2-stapsverificatie aan op dat account.
# 2. Maak een app-wachtwoord: https://myaccount.google.com/apppasswords
# 3. Vul hieronder het adres en het app-wachtwoord (16 tekens) in.
# Laat leeg om in voorbeeldstand te werken (mails worden dan niet verzonden).
GMAIL_USER=
GMAIL_APP_PASSWORD=

# Tijdens het testen: stuur ALLE mails naar dit adres in plaats van naar de collega's.
MAIL_TEST_ONTVANGER=

# Zet op "uit" bij echt gebruik: verbergt de knop "Demodata herstellen" en het postvak.
DEMO_MODUS=aan
